{
	"name": "transcendence",
	"version": "1.0.0",
	"description": "42 common core final project",
	"type": "module",
	"keywords": [],
	"author": "",
	"license": "ISC",
	"packageManager": "pnpm@10.11.0",
	"scripts": {
		"start": "node ./build/server/main.js",
		"cli": "node ./build/cli/main.js",
		"build": "rm -rf build && run-s build:*",
		"build:server": "tsc -p tsconfig.server.json",
		"build:client": "tsc -p tsconfig.client.json",
		"build:cli": "tsc -p tsconfig.cli.json",
		"build:style": "tailwindcss -i ./src/client/style.css -o ./build/public/style.css",
		"dev": "rm -rf build && run-p -l dev:*",
		"dev:run": "sleep 2 && export NODE_ENV=development && nodemon --delay 2000ms",
		"dev:server": "tsc -p tsconfig.server.json -w --preserveWatchOutput",
		"dev:client": "tsc -p tsconfig.client.json -w --preserveWatchOutput",
		"dev:cli": "tsc -p tsconfig.cli.json -w --preserveWatchOutput",
		"dev:style": "tailwindcss -i ./src/client/style.css -o ./build/public/style.css --watch",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:up": "drizzle-kit up",
		"seed": "rm -f local.db && drizzle-kit push && tsc -p tsconfig.server.json && node ./build/server/db/seed.js",
		"check": "biome check && run-s build:*",
		"checkfix": "biome check --write",
		"lint": "biome lint",
		"format": "biome format",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.0.6",
		"@tailwindcss/cli": "^4.1.10",
		"@types/node": "^24.0.3",
		"@types/web": "^0.0.243",
		"@types/ws": "^8.18.1",
		"babylonjs": "^8.15.0",
		"babylonjs-gui": "^8.15.0",
		"drizzle-kit": "^0.31.1",
		"husky": "^9.1.7",
		"nodemon": "^3.1.10",
		"npm-run-all": "^4.1.5",
		"pino-pretty": "^13.1.1",
		"tailwindcss": "^4.1.10",
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"@clack/prompts": "^0.11.0",
		"@fastify/cookie": "^11.0.2",
		"@fastify/cors": "^11.1.0",
		"@fastify/formbody": "^8.0.2",
		"@fastify/multipart": "^9.0.3",
		"@fastify/oauth2": "^8.1.2",
		"@fastify/sensible": "^6.0.3",
		"@fastify/static": "^8.2.0",
		"@fastify/websocket": "^11.1.0",
		"@libsql/client": "^0.15.9",
		"argon2": "^0.43.0",
		"chalk": "^5.6.0",
		"dotenv": "^16.5.0",
		"drizzle-orm": "^0.44.2",
		"drizzle-seed": "^0.3.1",
		"fastify": "^5.4.0",
		"fastify-plugin": "^5.0.1",
		"fastify-type-provider-zod": "^5.0.1",
		"pino": "^9.7.0",
		"sharp": "^0.34.3",
		"zod": "^3.25.67"
	}
}
